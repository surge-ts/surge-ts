# Editor / IDE
.vscode
.idea

# Rust / build artifacts
target

# JavaScript / TypeScript
node_modules/
.pnpm-store/
dist
coverage
*.tsbuildinfo

# Generated / local files
digest.txt
.local-projects/
.bench
.env

# Logs / OS cruft
*.log
pnpm-debug.log*
npm-debug.log*
.DS_Store

# `tsc` emit. No JavaScript is authored in this workspace outside the fixture
# packages re-included below, so an emitted sibling of a .ts/.cts/.mts source is
# build output from a compiler run that forgot --noEmit.
*.js
*.cjs
*.mjs

# Test fixtures ship hand-written node_modules (package-resolution tests read
# them), so re-include them — including dist/ dirs inside — but keep OS cruft out.
!tests/compat-projects/**/node_modules/
!tests/compat-projects/**/node_modules/**
# Untyped-module fixtures import hand-written JavaScript beside their sources.
!tests/compat-projects/untyped-javascript-module-*/**/*.js
# The npm package's JavaScript facade is authored by hand.
!packages/surge-ts/**/*.cjs
!packages/surge-ts/**/*.mjs
# bench:checkers reads tsgo's API through this ES module.
!scripts/bench/tsgo-api-diagnostics.mjs
packages/surge-ts/*.node
tests/compat-projects/**/.DS_Store
.serena/

# trail: local learnings, code-map cache and hooks — not committed.
/.trail/
